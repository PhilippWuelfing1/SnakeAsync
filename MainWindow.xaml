<Window x:Class="SnakeAsync.MainWindow"
        x:Name="SnakeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SnakeAsync"
        mc:Ignorable="d"
        Title="MainWindow" Height="1400" Width="1400" FocusManager.FocusedElement="{Binding ElementName=canv}"
        StateChanged="Window_StateChanged"
        WindowState="Maximized"
        WindowStartupLocation="Manual"
        Left="0" 
        Top="0" 
        Loaded="Window_Loaded"        
        >

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Zeilenhöhe passt sich dem Inhalt an -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!-- Zeile nimmt den restlichen verfügbaren Platz ein -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="200" Height="30" FontSize="20" FontWeight="Bold" Foreground="Black" Background="Yellow">
            <TextBlock.Text>
                <MultiBinding StringFormat="Snake: {0,0:F0} , {1,0:F0}">
                    <Binding ElementName="SnakeWindow" Path="SnakeHead_x" />
                    <Binding ElementName="SnakeWindow" Path="SnakeHead_y" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="200" Height="30" FontSize="20" FontWeight="Bold" Foreground="Black" Background="Red"
                   Text="{Binding ElementName=SnakeWindow, Path=SnakeLaenge, StringFormat=Länge: {0}}">
        </TextBlock>

        <Canvas Grid.Row="2" Name="canv" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" PreviewKeyDown="canv_PreviewKeyDown" Focusable="True" Grid.RowSpan="3">
            <Polyline 
                    Name="snake" 
                    Points="100,400 120, 400, 140, 400, 160, 400, 180, 400, 200, 400 220, 400 240, 400 260, 400 280, 400 300, 400"
                    Stroke="Green" 
                    StrokeThickness="15" 
                    StrokeLineJoin="Bevel" />
        </Canvas>

    </Grid>
</Window>
